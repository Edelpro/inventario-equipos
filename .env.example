# Variables de entorno del inventario (copiar a .env solo en local; .env no se versiona).
# Ninguna variable contiene secretos.

# Puerto interno del proceso Node. En contenedor siempre 3000; el host publica 3001 o 3002.
PORT=3000

# Interfaz de escucha. En local puede usarse 127.0.0.1; en contenedor 0.0.0.0.
HOST=127.0.0.1

# SHA del commit que se ejecuta. En la imagen lo fija GitHub Actions (APP_REVISION=github.sha).
APP_REVISION=desconocida

# Nombre del entorno: local | staging | produccion
APP_ENTORNO=local
